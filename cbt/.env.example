APP_NAME="CBT MAN 1 PALEMBANG"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://cbt.example.sch.id
APP_TIMEZONE=Asia/Jakarta
APP_KEY=generate-a-random-secret-of-at-least-32-characters
SETUP_TOKEN=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

PORTAL_DATA_BASE_URL=
PORTAL_DATA_SYNC_CLIENT_ID=
PORTAL_DATA_SYNC_CLIENT_SECRET=
PORTAL_DATA_TIMEOUT=5
PORTAL_DATA_VERIFY_SSL=true

# OIDC SSO Portal Guru (daftarkan client di Portal Data)
PORTAL_DATA_OIDC_ISSUER=https://sipadu.example.sch.id/oidc
PORTAL_DATA_OIDC_CLIENT_ID=
PORTAL_DATA_OIDC_REDIRECT_URI=https://cbt.example.sch.id/auth/sso/callback
PORTAL_DATA_OIDC_POST_LOGOUT_URI=https://cbt.example.sch.id/guru

SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=7200

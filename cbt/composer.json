{
  "name": "man1-palembang/cbt",
  "description": "CBT MAN 1 Palembang - PHP Native, MySQL, Portal Data integration",
  "type": "project",
  "require": {"php": "^8.2", "ext-pdo": "*", "ext-curl": "*", "vlucas/phpdotenv": "^5.6", "monolog/monolog": "^3.8", "phpoffice/phpspreadsheet": "^2.2"},
  "require-dev": {"phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"Cbt\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "@php tests/run.php", "test:phpunit": "phpunit", "lint": "@php scripts/lint.php", "migrate": "@php database/migrate.php", "seed": "@php database/seed.php"},
  "config": {"optimize-autoloader": true, "sort-packages": true}
}

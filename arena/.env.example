HOST=127.0.0.1
PORT=3001
LOG_LEVEL=warn
DATABASE_URL=mysql://arena_app:arena-dev-only@127.0.0.1:3308/arena
DB_POOL_SIZE=12
DB_QUEUE_LIMIT=10000
DB_CONNECT_TIMEOUT_MS=10000
EXAM_QUESTION_SOURCE_TTL_MS=2000
EXAM_QUESTION_SOURCE_CACHE_MAX=16
# Cache soal Redis memakai alamat revision authoritative dari MySQL
# (exams.source_revision, migrasi 015). TTL hanya pembersih memori, bukan
# jaminan kebenaran — Redis restart tidak pernah menyajikan soal stale.
# Default 1 jam, clamp maksimum 24 jam.
EXAM_QUESTION_REDIS_TTL_MS=3600000
# Pre-warm cache soal: mengisi payload revision terbaru ke Redis saat admin
# memutasi soal dan saat waiting room melepas batch siswa, supaya siswa tidak
# pernah membayar satu kali miss cache pertama. `off` menonaktifkan semua
# trigger pre-warm (lazy loader tetap jalan dan tetap DB-authoritative).
EXAM_QUESTION_PREWARM=on
# TTL lock anti-stampede pre-warm (ms). Hanya satu proses yang mengisi payload
# per exam; holder yang mati otomatis terlepas setelah TTL ini.
EXAM_QUESTION_PREWARM_LOCK_MS=30000
ATTEMPT_FINALIZER_ENABLED=true
ATTEMPT_FINALIZER_INTERVAL_MS=30000
ATTEMPT_FINALIZER_BATCH_SIZE=50
ARENA_EXAM_DIAGNOSTICS=true
# Aktifkan sementara saat uji login staging; hanya mencatat metrik agregat tanpa NISN/PIN.
ARENA_LOGIN_DIAGNOSTICS=false
# Tahap 3: log agregat claim/submit/result/SSE/transisi ruang tunggu (tanpa NISN).
ARENA_LOAD_DIAGNOSTICS=false
# Satu worker bcrypt per proses PM2; tiga proses = tiga worker pada empat vCPU.
PASSWORD_VERIFY_WORKERS=1
PASSWORD_VERIFY_QUEUE_LIMIT=5000
PASSWORD_VERIFY_CONCURRENCY_PER_WORKER=4
AUTH_TOKEN_SECRET=replace-with-random-secret-at-least-32-characters
# Kunci AES-256-GCM untuk PIN yang dapat dicetak ulang. Simpan permanen dan backup terpisah.
PIN_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379
REDIS_COMMAND_TIMEOUT_MS=1000
# FIFO per ID ujian; prioritas tingkat dan batas 3 menit tidak digunakan.
WAITING_BATCH_SIZE=300
WAITING_BATCH_INTERVAL_MS=10000
WAITING_HEARTBEAT_TIMEOUT_MS=90000
WAITING_CLAIM_TIMEOUT_MS=60000
WAITING_WORKER_TICK_MS=1000
# false jika memakai worker terpisah.
WAITING_WORKER_ENABLED=true
TRUST_PROXY=false
SETUP_TOKEN=replace-with-one-time-random-token

PORTAL_DATA_BASE_URL=https://sipadu.example.sch.id
PORTAL_DATA_SYNC_CLIENT_ID=
PORTAL_DATA_SYNC_CLIENT_SECRET=
OIDC_ISSUER=https://sipadu.example.sch.id/oidc
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=https://arena.example.sch.id/auth/sso/callback
OIDC_POST_LOGOUT_URI=https://arena.example.sch.id/guru
ARENA_WEB_URL=https://arena.example.sch.id
# Direktori persisten untuk gambar soal; backup bersama database Arena.
ARENA_UPLOAD_DIR=./storage/question-images

# Separate BullMQ finalization worker (production PM2 profile disables API finalizers).
FINALIZATION_CONCURRENCY=4
# Tahap 2 — submit asinkron (durable acceptance di MySQL + scoring di worker).
# off = jalur sinkron lama (default produksi, aktifkan hanya di staging).
# Menyalakan flag ini berarti /submit tidak lagi menunggu scoring.
SUBMIT_ASYNC=off
# Durasi lease klaim submission (ms, clamp 5000..600000). Worker memperpanjang
# lease otomatis setiap lease/3; worker mati akan diambil alih setelah lease
# kedaluwarsa.
SUBMIT_LEASE_MS=60000
# Batas percobaan klaim (1..20). Setelah tercapai, submission menjadi
# SKIPPED(lease_exhausted) dan tidak diproses ulang tanpa tindakan admin.
SUBMIT_LEASE_MAX_ATTEMPTS=5

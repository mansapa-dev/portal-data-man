HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DATABASE_URL=mysql://arena_app:change-me@127.0.0.1:3306/arena
DB_POOL_SIZE=20
DB_QUEUE_LIMIT=500
ATTEMPT_FINALIZER_ENABLED=true
ATTEMPT_FINALIZER_INTERVAL_MS=30000
ATTEMPT_FINALIZER_BATCH_SIZE=50
# Aktifkan sementara saat uji login staging; hanya mencatat metrik agregat tanpa NISN/PIN.
ARENA_LOGIN_DIAGNOSTICS=false
# Worker verifikasi bcrypt login siswa. Default otomatis, maksimal 3 worker.
PASSWORD_VERIFY_WORKERS=3
PASSWORD_VERIFY_QUEUE_LIMIT=1000
AUTH_TOKEN_SECRET=replace-with-random-secret-at-least-32-characters
# Kunci AES-256-GCM untuk PIN yang dapat dicetak ulang. Simpan permanen dan backup terpisah.
PIN_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379
TRUST_PROXY=false
SETUP_TOKEN=replace-with-one-time-random-token

PORTAL_DATA_BASE_URL=https://sipadu.example.sch.id
PORTAL_DATA_SYNC_CLIENT_ID=
PORTAL_DATA_SYNC_CLIENT_SECRET=
OIDC_ISSUER=https://sipadu.example.sch.id/oidc
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=https://arena.example.sch.id/auth/sso/callback
OIDC_POST_LOGOUT_URI=https://arena.example.sch.id/guru
ARENA_WEB_URL=https://arena.example.sch.id
# Direktori persisten untuk gambar soal; backup bersama database Arena.
ARENA_UPLOAD_DIR=./storage/question-images

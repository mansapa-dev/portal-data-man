{
  "name": "arena-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:services": "concurrently -k -n api,web -c blue,green \"npm run dev -w @arena/api\" \"npm run dev -w @arena/web\"",
    "dev:local": "bash scripts/start-local-demo.sh",
    "local:setup": "bash scripts/setup-local-demo.sh",
    "demo:migrate": "node scripts/migrate-local.mjs",
    "demo:migrate:integrity": "node scripts/migrate-integrity-local.mjs",
    "demo:seed": "node scripts/seed-local-demo.mjs",
    "build": "npm run build -w @arena/api && npm run build -w @arena/web",
    "start": "npm run start -w @arena/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@arena/web": "^0.1.0"
  }
}

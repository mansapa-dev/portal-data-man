APP_NAME="Portal Data"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug
HASH_DRIVER=argon

IMPORT_MAX_ROWS=5000
IMPORT_MAX_FILE_SIZE_MB=10
EXPORT_MAX_ROWS=10000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_data
DB_USERNAME=portal_data_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

OIDC_ISSUER=http://localhost:8000/oidc
OIDC_PRIVATE_KEY_PATH=
OIDC_PUBLIC_KEY_PATH=
OIDC_KEY_ID=portal-data-signing-1
OIDC_ACCESS_TOKEN_TTL=900
OIDC_AUTHORIZATION_CODE_TTL=600

SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Backend-only key shared with CBT PORTAL_DATA_API_KEY. Generate a long random value.
CBT_INTEGRATION_API_KEY=

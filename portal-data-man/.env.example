NODE_ENV=development
PORT=3000
APP_NAME="Portal Data"
APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portal Data <your-account@gmail.com>"
API_PREFIX=api/v1
TRUST_PROXY=1
DATABASE_URL=mysql://username:password@localhost:3306/portal_data
SESSION_SECRET=
CSRF_SECRET=
COOKIE_DOMAIN=
COOKIE_SECURE=false
OIDC_ISSUER=http://localhost:3000/oidc
OIDC_JWKS_JSON=
OIDC_COOKIE_KEYS=replace-with-random-key-1,replace-with-random-key-2
OIDC_ACCESS_TOKEN_TTL=900
OIDC_REFRESH_TOKEN_TTL=2592000
OIDC_AUTHORIZATION_CODE_TTL=600
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
STORAGE_PATH=./storage
IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_MAX_ROWS=5000
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=5
LOG_LEVEL=info
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

{
  "name": "man1-palembang/jurnal-kelas",
  "description": "Jurnal kelas MAN 1 Palembang berbasis PHP native terstruktur.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-fileinfo": "*",
    "ext-curl": "*",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.8",
    "phpoffice/phpspreadsheet": "^2.2",
    "dompdf/dompdf": "^3.1"
  },
  "require-dev": {"phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "test": "phpunit",
    "lint": "@php scripts/lint.php",
    "migrate": "@php database/migrate.php",
    "seed": "@php database/seed.php"
  },
  "config": {"optimize-autoloader": true, "sort-packages": true}
}
